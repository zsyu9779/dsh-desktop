{
  "name": "dsh-agent-preset-compat",
  "version": "0.1.0",
  "description": "Keep sessions created before DSH renamed the `code` agent preset resumable: alias it to `ptc` in the user preset root.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "agent-preset",
    "compatibility"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT"
}
