{
  "name": "dsh-webview-compat",
  "version": "0.1.0",
  "description": "Make upstream client bundles that assume a newer WebKit run on the desktop shell's WebView: define the iterator-helpers global they feature-detect before the module graph loads.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.2.0"
  },
  "dsh": {
    "desktop": {
      "vendored": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "webview",
    "compatibility"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1"
  },
  "license": "MIT"
}
