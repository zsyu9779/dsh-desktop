{
  "name": "dsh-webview-links",
  "version": "0.1.2",
  "description": "Route the external links a session opens out of the desktop shell's WebView and into the system browser: Wails' macOS WebView cannot open a new window itself, and DSH >= 0.2 opens them through window.open.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.2.0"
  },
  "dsh": {
    "desktop": {
      "vendored": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "webview",
    "links"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1 || ^0.2.0-rc.2"
  },
  "license": "MIT"
}
